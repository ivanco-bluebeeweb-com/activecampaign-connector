          "id": {
            "default": "",
            "title": "Id",
            "type": "string"
          }
        },
        "title": "DeleteResult",
        "type": "object"
      },
      "event": "activecampaign-connector.disconnect_activecampaign",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_activecampaign-connector_chat"
    },
