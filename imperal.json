{
  "manifest_schema_version": 3,
  "sdk_version": "5.13.0",
  "app_id": "activecampaign-connector",
  "version": "0.1.0",
  "name": "ActiveCampaign",
  "description": "Connect your own ActiveCampaign account (API URL + API key) to manage contacts, lists, campaigns, automations, and deals.",
  "icon": "icon.svg",
  "actions_explicit": true,
  "system": false,
  "capabilities": [
    "activecampaign:read",
    "activecampaign:write"
  ],
  "tools": [
    {
      "name": "connect_activecampaign",
      "description": "Connect your own ActiveCampaign account by saving its API URL and API key, after checking they actually work.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "create:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "label": {
            "default": "",
            "description": "A friendly name for this account, e.g. 'Marketing team'.",
            "title": "Label",
            "type": "string"
          },
          "api_url": {
            "description": "Your ActiveCampaign account URL or API URL, e.g. https://youraccount.api-us1.com/api/3 (Settings > Developer).",
            "title": "Api Url",
            "type": "string"
          },
          "access_token": {
            "description": "Your ActiveCampaign API key (Settings > Developer).",
            "title": "Access Token",
            "type": "string"
          }
        },
        "required": [
          "api_url",
          "access_token"
        ],
        "title": "ConnectActiveCampaignParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "connection_id": {
            "default": "",
            "title": "Connection Id",
            "type": "string"
          },
          "label": {
            "default": "",
            "title": "Label",
            "type": "string"
          },
          "api_url": {
            "default": "",
            "title": "Api Url",
            "type": "string"
          }
        },
        "title": "ConnectActiveCampaignResult",
        "type": "object"
      },
      "event": "activecampaign-connector.connect_activecampaign",
      "background": false,
      "long_running": false,
      "scopes": [],
      "owner_chat_tool": "tool_activecampaign-connector_chat"
    },
    {
      "name": "disconnect_activecampaign",
      "description": "Disconnect an ActiveCampaign account: deletes the saved API URL/API key. Nothing in ActiveCampaign itself is changed.",
      "action_type": "write",
      "chain_callable": true,
      "effects": [
        "delete:connection"
      ],
      "id_projection": "",
      "params_schema": {
        "properties": {
          "connection_id": {
            "description": "The connection id to disconnect, from list_connections.",
            "title": "Connection Id",
            "type": "string"
          }
        },
        "required": [
          "connection_id"
        ],
        "title": "DisconnectActiveCampaignParams",
        "type": "object"
      },
      "return_schema": {
        "properties": {
          "deleted": {
            "default": false,
            "title": "Deleted",
            "type": "boolean"
